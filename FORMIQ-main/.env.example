# FormIQ Environment Configuration

# Supabase Public Configuration (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret (NEVER exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Provider Configuration (Google Gemini / OpenAI / Anthropic)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model overrides:
GEMINI_MODEL=gemini-2.0-flash

# Base App URL for shareable links & QR codes
NEXT_PUBLIC_APP_URL=http://localhost:3000
